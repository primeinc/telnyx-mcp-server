{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "jwtSecretKey": {
      "value": "${JWT_SECRET_KEY}"
    },
    "telnyxApiKey": {
      "value": "${TELNYX_API_KEY}"
    },
    "environment": {
      "value": "${ENVIRONMENT}"
    },
    "useKeyVault": {
      "value": "${USE_KEY_VAULT}"
    },
    "useRedis": {
      "value": "${USE_REDIS}"
    },
    "createOAuthApp": {
      "value": "${CREATE_OAUTH_APP}"
    },
    "gitHubOwner": {
      "value": "${GITHUB_OWNER}"
    },
    "gitHubRepo": {
      "value": "${GITHUB_REPO}"
    },
    "dataClassification": {
      "value": "${DATA_CLASSIFICATION}"
    },
    "businessCriticality": {
      "value": "${BUSINESS_CRITICALITY}"
    },
    "businessUnit": {
      "value": "${BUSINESS_UNIT}"
    },
    "opsTeam": {
      "value": "${OPS_TEAM}"
    }
  }
}
